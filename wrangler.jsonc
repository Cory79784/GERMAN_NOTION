{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "german-notion",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "NOTION_DATA_SOURCE_ID": "2aaff02b-8ca6-41bc-9c61-fb482528ccf3",
    "NOTION_SCREENSHOT_DATA_SOURCE_ID": "a104f734-ef60-4daf-896b-12c7d9c806bd",
    "NOTION_SCREENSHOT_DATABASE_ID": "54f3e119-3122-40f5-80dc-cd8a6e9316f1"
  },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARED_PREFERENCES",
        "class_name": "SharedPreferences"
      }
    ]
  },
  "migrations": [
    {
      "tag": "preferences-v1",
      "new_sqlite_classes": [
        "SharedPreferences"
      ]
    }
  ]
}
